<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AetheriumPhones" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/google_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/google_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/google_blue_dark</item>
        <item name="colorSecondary">@color/google_grey</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:windowBackground">@color/phone_background</item>
        <item name="android:statusBarColor">@color/phone_surface</item>
        <item name="android:navigationBarColor">@color/phone_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.AetheriumPhone.Button</item>
    </style>

    <style name="Widget.AetheriumPhone.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.AetheriumPhone.Button.Call" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/call_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.AetheriumPhone.Button.EndCall" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/end_call_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
