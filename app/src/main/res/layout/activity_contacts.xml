<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarContacts"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/phone_surface"
        app:title="@string/launcher_contacts_label"
        app:titleTextColor="@color/phone_on_surface"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/contactsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarContacts" />

</androidx.constraintlayout.widget.ConstraintLayout>
